{
  "name": "donggonga",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donggonga-db",
      // `npx wrangler d1 create donggonga-db` 실행 후 나온 database_id 로 바꿔 주세요
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "donggonga-files" }
  ]
}
