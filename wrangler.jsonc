{
  "name": "donggonga",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  // 도메인: 호스팅케이알에서 구매, 네임서버를 Cloudflare 로 바꾼 뒤 연결 (www 는 worker.js 에서 dtcenter.co.kr 로 이동)
  "routes": [
    { "pattern": "dtcenter.co.kr", "custom_domain": true },
    { "pattern": "www.dtcenter.co.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "donggonga-db",
      "database_id": "42d50aaa-3ee4-42b6-8b37-0651126503ef",
      "migrations_dir": "migrations"
    }
  ]
  // R2 를 켠 뒤에는 `npx wrangler r2 bucket create donggonga-files` 하고 아래를 추가하면
  // 새로 올라오는 시험지 파일이 R2 에 저장된다 (지금은 D1 file_chunks 테이블에 저장).
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "donggonga-files" }]
}
